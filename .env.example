# ==============================================================================
# ArogyaSetu — Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NOTE: .env is strictly ignored by Git and should NEVER be committed.
# ==============================================================================

# Google Gemini API Key
# Required for: Gemini 3.6 Flash Vision OCR & Autonomous Rebalancing Agent
# If omitted, the platform gracefully engages the deterministic offline fallback engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Server Host and Port (Google Cloud Run automatically sets PORT=8080)
HOST=0.0.0.0
PORT=8000

# Runtime Environment (development / production)
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated list or '*' for open development/evaluation)
CORS_ORIGINS=*

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
